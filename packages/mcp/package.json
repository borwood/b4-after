{
  "name": "cb4-mcp",
  "version": "0.3.0",
  "description": "See changes to your architecture before and as you build them: an MCP server and CLI that lets coding agents model a system as C4 (LikeC4), propose and review changes, promote accepted ones, and record the evidence that verifies them",
  "license": "MIT",
  "author": "borwood",
  "homepage": "https://github.com/borwood/cb4#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borwood/cb4.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/borwood/cb4/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "architecture",
    "c4",
    "likec4",
    "architecture-as-code",
    "change-ledger",
    "ai-agents",
    "claude-code",
    "codex"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cb4": "bin/cb4.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "cb4-ledger": "0.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
