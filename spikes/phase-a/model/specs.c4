// Specification: element kinds and relationship kinds for the billing example.
// Comments and odd spacing are deliberate: the round-trip spike checks whether they survive.
specification {
  element actor {
    style { shape person }
  }
  element system
  element container
  element component
  element datastore {
    style { shape cylinder }
  }

  relationship uses
  relationship publishes_to
  relationship reads_from
  relationship writes_to

  tag external { color #64748b }
  tag candidate { color #d97706 }   // explicit hex: generator cannot round-trip auto-assigned tag colors
}
